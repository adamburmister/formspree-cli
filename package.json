{
  "name": "@formspree/cli",
  "version": "0.9.6",
  "description": "The Formspree command line interface",
  "keywords": [
    "dotenv",
    "formspree"
  ],
  "homepage": "https://github.com/formspree/formspree-cli#readme",
  "bugs": {
    "url": "https://github.com/formspree/formspree-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/formspree/formspree-cli.git"
  },
  "license": "MIT",
  "author": "Derrick Reimer",
  "type": "module",
  "bin": {
    "formspree": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/cli.ts",
    "format": "prettier --write .",
    "prepack": "npm run build",
    "prepare": "husky || true",
    "release": "np",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": "prettier --write",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@formspree/deploy": "^0.3.4",
    "axios": "^1.21.1",
    "chalk": "^6.0.1",
    "common-tags": "^1.8.2",
    "dotenv": "^18.0.10",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/node": "^24.19.2",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "np": "^12.1.1",
    "prettier": "^3.9.10",
    "sort-package-json": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">= 24"
  },
  "publishConfig": {
    "access": "public"
  },
  "np": {
    "yarn": false
  }
}
